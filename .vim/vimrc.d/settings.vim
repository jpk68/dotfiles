syntax on
filetype plugin indent on
colorscheme gruvbox
set background=dark
set encoding=utf8
set laststatus=2

set tabstop=4
set shiftwidth=4
set softtabstop=4
set scrolloff=8
set colorcolumn=100

set number relativenumber
set cursorline
set nowrap
set expandtab
set incsearch hlsearch
set autoindent smartindent cindent
set ignorecase smartcase
set nocompatible

set ffs=unix
set history=100
set nobackup
set nowb
set noswapfile

set wildmenu
set magic
